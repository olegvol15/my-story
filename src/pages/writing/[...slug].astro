---
import { render } from "astro:content";
import type { GetStaticPaths } from "astro";
import { profile } from "../../data/content";
import { toExcerpt } from "../../lib/excerpt";
import { formatDate, getPublishedPosts, toISODate } from "../../lib/posts";
import Article from "../../layouts/Article.astro";
import Subscribe from "../../components/Subscribe.astro";

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, cover, coverAlt } = post.data;
const description = post.data.description ?? toExcerpt(post.body ?? "");
---

<Article
  title={`${title} - ${profile.name}`}
  ogTitle={title}
  description={description}
  type="article"
  publishedTime={date}
  heading={title}
  cover={cover}
  coverAlt={coverAlt}
  backHref="/#writing"
>
  <time slot="meta" datetime={toISODate(date)}>{formatDate(date)}</time>
  <Content />
  <Subscribe slot="after" revealDelay="320ms" />
</Article>
