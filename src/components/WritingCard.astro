---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"writing">;
}

const { post } = Astro.props;
const { title, date, cover, coverAlt } = post.data;

const displayDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class="card">
  <div class="card-media">
    {cover && <Image src={cover} alt={coverAlt} widths={[400, 800]} sizes="(max-width: 640px) 100vw, 22rem" />}
  </div>
  <h3><a href={`/writing/${post.id}`}>{title}</a></h3>
  <time datetime={date.toISOString().slice(0, 10)}>{displayDate}</time>
</article>

<style>
.card {
  position: relative;
}

.card-media {
  aspect-ratio: 16 / 9;
  overflow: hidden;
  border-radius: var(--radius);
  border: 1px solid var(--hairline);
  background: var(--surface);
}

.card-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition:
    transform 0.4s ease,
    opacity 0.3s ease;
  opacity: 0.85;
}

.card:hover .card-media img {
  transform: scale(1.03);
  opacity: 1;
}

.card h3 {
  font-size: 1rem;
  font-weight: 600;
  line-height: 1.4;
  color: var(--fg);
  letter-spacing: -0.01em;
  margin: 0.9rem 0 0.3rem;
}

.card h3 a {
  text-decoration: none;
}

.card h3 a::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: var(--radius);
}

.card time {
  display: block;
  font-size: 0.85rem;
  color: var(--muted);
}
</style>
