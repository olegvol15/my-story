---
import { render } from "astro:content";
import type { GetStaticPaths } from "astro";
import { profile } from "../../data/content";
import { toISODate } from "../../lib/posts";
import { getPublishedProjects, statusLabel } from "../../lib/projects";
import Article from "../../layouts/Article.astro";
import ProjectBoard from "../../components/ProjectBoard.astro";

export const getStaticPaths = (async () => {
  const projects = await getPublishedProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, status, started, cover, coverAlt, stack, links, tickets } = project.data;

const monthYear = (date: Date) =>
  date.toLocaleDateString("en-US", { year: "numeric", month: "long" });
---

<Article
  title={`${title} - ${profile.name}`}
  ogTitle={title}
  description={description}
  heading={title}
  cover={cover}
  coverAlt={coverAlt}
  backHref="/#projects"
>
  <Fragment slot="meta">
    <p class="facts">
      <span class="status" data-status={status}>{statusLabel[status]}</span>
      <span>Started <time datetime={toISODate(started)}>{monthYear(started)}</time></span>
    </p>
    {stack.length > 0 && <p class="stack">{stack.join(" · ")}</p>}
    {links.length > 0 && (
      <ul class="project-links">
        {links.map((link) => (
          <li><a href={link.href} rel="noopener" target="_blank">{link.label} ↗</a></li>
        ))}
      </ul>
    )}
  </Fragment>

  <Content />

  {tickets.length > 0 && (
    <div slot="after" data-reveal style="--reveal-delay: 320ms">
      <ProjectBoard project={project} />
    </div>
  )}
</Article>

<style>
.facts,
.stack {
  margin: 0;
}

.facts {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.4rem 1rem;
}

.status {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  color: var(--fg);
  font-weight: 500;
}

.status::before {
  content: "";
  width: 7px;
  height: 7px;
  border-radius: 999px;
  background: var(--muted);
}

.status[data-status="live"]::before {
  background: #4ade80;
  box-shadow: 0 0 0 3px rgba(74, 222, 128, 0.15);
}

.status[data-status="building"]::before {
  background: var(--body);
}

.stack {
  margin-top: 0.35rem;
}

.project-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem 1.25rem;
  list-style: none;
  margin: 0.6rem 0 0;
  padding: 0;
}

.project-links a {
  color: var(--body);
  text-decoration: none;
}

.project-links a:hover {
  color: var(--fg);
}

</style>
