---
import { formatDate, toISODate } from "../lib/posts";
import { getPublishedProjects, lastActivity, statusLabel } from "../lib/projects";
import Card from "./Card.astro";
import CardSection from "./CardSection.astro";

interface Props {
  revealDelay?: string;
}

const { revealDelay } = Astro.props;
const projects = await getPublishedProjects();
---

{projects.length > 0 && (
  <CardSection id="projects" heading="Projects" revealDelay={revealDelay}>
    {projects.map((project) => {
      const { title, cover, coverAlt, status } = project.data;
      const updated = lastActivity(project);
      return (
        <Card href={`/projects/${project.id}`} title={title} cover={cover} coverAlt={coverAlt}>
          {statusLabel[status]} · updated{" "}
          <time datetime={toISODate(updated)}>{formatDate(updated)}</time>
        </Card>
      );
    })}
  </CardSection>
)}
