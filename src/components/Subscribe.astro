---
import { newsletter } from "../data/content";

const configured = newsletter.action.length > 0;
---

<section class="subscribe" aria-labelledby="subscribe-heading">
  <h2 id="subscribe-heading">{newsletter.heading}</h2>

  <form
    class="subscribe-form"
    action={configured ? newsletter.action : undefined}
    method="post"
    target="_blank"
  >
    <label class="sr-status" for="subscribe-email">Email address</label>
    <input
      id="subscribe-email"
      class="subscribe-input"
      type="email"
      name={newsletter.field}
      placeholder={newsletter.placeholder}
      autocomplete="email"
      required
      disabled={!configured}
    />
    <button class="subscribe-button" type="submit" disabled={!configured}>
      {newsletter.cta}
    </button>
  </form>

  <p class="subscribe-follow">
    And follow me on{" "}
    <a href={newsletter.followHref} rel="me noopener" target="_blank">
      {newsletter.followLabel}
    </a>{" "}
    where I'm very active
  </p>
</section>

<div class="toast" role="status" aria-live="polite" data-state="idle"></div>

<script>
  const form = document.querySelector<HTMLFormElement>(".subscribe-form");
  const toast = document.querySelector<HTMLDivElement>(".toast");
  const input = document.querySelector<HTMLInputElement>(".subscribe-input");
  const button = document.querySelector<HTMLButtonElement>(".subscribe-button");

  if (form && toast && input && button && form.action) {
    let timer = 0;

    const show = (message: string, tone: "ok" | "error") => {
      toast.textContent = message;
      toast.dataset.tone = tone;
      toast.dataset.state = "visible";
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        toast.dataset.state = "idle";
      }, tone === "error" ? 6000 : 4500);
    };

    // JS takes over, so the no-JS fallback of opening Kit's page is never used.
    form.removeAttribute("target");

    const label = button.textContent ?? "Subscribe";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (button.disabled) return;

      button.disabled = true;
      button.textContent = "Subscribing…";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify({ [input.name]: input.value }),
        });

        const data = await response.json().catch(() => null);

        if (response.ok && data && data.status !== "failed") {
          form.reset();
          input.blur();
          show("Thanks — you're on the list. Check your inbox.", "ok");
          return;
        }

        show(data?.errors?.messages?.[0] ?? "Something went wrong. Try again?", "error");
      } catch {
        show("Couldn't reach the server. Try again?", "error");
      } finally {
        button.disabled = false;
        button.textContent = label;
      }
    });
  }
</script>

<style>
.subscribe {
  margin-top: clamp(4rem, 10vh, 6rem);
}

.subscribe h2 {
  font-size: clamp(1.05rem, 1.8vw, 1.25rem);
  font-weight: 600;
  color: var(--fg);
  letter-spacing: -0.015em;
  margin: 0 0 1.25rem;
}

.subscribe-form {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  align-items: stretch;
}

.subscribe-input {
  flex: 1 1 18rem;
  min-width: 0;
  font: inherit;
  font-size: 0.95rem;
  color: var(--fg);
  background: var(--surface);
  border: 1px solid var(--hairline);
  border-radius: var(--radius);
  padding: 0.75rem 1rem;
  transition:
    border-color 0.2s ease,
    background 0.2s ease;
}

.subscribe-input::placeholder {
  color: var(--muted);
}

.subscribe-input:hover:not(:disabled) {
  border-color: rgba(255, 255, 255, 0.18);
}

.subscribe-input:focus {
  outline: none;
  border-color: rgba(255, 255, 255, 0.35);
  background: rgba(255, 255, 255, 0.05);
}

.subscribe-button {
  font: inherit;
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--fg);
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid var(--hairline);
  border-radius: var(--radius);
  padding: 0.75rem 1.5rem;
  cursor: pointer;
  -webkit-appearance: none;
  appearance: none;
  transition:
    background 0.2s ease,
    border-color 0.2s ease;
}

.subscribe-button:hover:not(:disabled) {
  background: rgba(255, 255, 255, 0.16);
  border-color: rgba(255, 255, 255, 0.28);
}

.subscribe-input:disabled,
.subscribe-button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.toast {
  position: fixed;
  right: var(--gutter);
  bottom: var(--gutter);
  z-index: 50;
  max-width: min(23rem, calc(100vw - 2 * var(--gutter)));
  margin: 0;
  padding: 0.85rem 1.05rem;
  border: 1px solid var(--hairline);
  border-radius: var(--radius);
  background: rgba(14, 16, 21, 0.92);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
  color: var(--fg);
  font-size: 0.92rem;
  line-height: 1.5;
  opacity: 0;
  visibility: hidden;
  transform: translateY(14px);
  transition:
    opacity 260ms ease,
    transform 300ms cubic-bezier(0.2, 0.7, 0.3, 1),
    visibility 0s linear 300ms;
}

.toast[data-state="visible"] {
  opacity: 1;
  visibility: visible;
  transform: none;
  transition-delay: 0s;
}

.toast[data-tone="ok"] {
  border-color: rgba(52, 211, 153, 0.35);
  background: rgba(8, 34, 26, 0.94);
  color: #a7f3d0;
}

.toast[data-tone="error"] {
  border-color: rgba(232, 160, 160, 0.32);
  color: #f0c8c8;
}

@media (prefers-reduced-motion: reduce) {
  .toast {
    transition: opacity 120ms linear, visibility 0s linear 120ms;
    transform: none;
  }
}

.subscribe-follow {
  margin: 1rem 0 0;
  font-size: 0.95rem;
  color: var(--muted);
}

.subscribe-follow a {
  color: var(--fg);
  text-decoration: none;
  border-bottom: 1px solid var(--hairline);
}

.subscribe-follow a:hover {
  border-color: var(--fg);
}
</style>
