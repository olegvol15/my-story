---
import { Image } from "astro:assets";
import type { ComponentProps } from "astro/types";
import { profile } from "../data/content";
import BaseHead from "../components/BaseHead.astro";
import Base from "./Base.astro";

type Props = ComponentProps<typeof BaseHead> & {
  heading: string;
  backHref?: string;
  cover?: ImageMetadata;
  coverAlt?: string;
};

const { heading, backHref = "/", cover, coverAlt = "", ...head } = Astro.props;
---

<Base {...head} image={head.image ?? cover} imageAlt={head.imageAlt ?? coverAlt}>
  <a class="back" href={backHref} data-reveal>← {profile.name}</a>

  <header class="post-header" data-reveal style="--reveal-delay: 80ms">
    <h1>{heading}</h1>
    <div class="post-meta"><slot name="meta" /></div>
  </header>

  {cover && (
    <Image
      class="post-cover"
      src={cover}
      alt={coverAlt}
      widths={[600, 1200]}
      sizes="44rem"
      loading="eager"
      data-reveal
      style="--reveal-delay: 160ms"
    />
  )}

  <div class="prose" data-reveal style="--reveal-delay: 240ms">
    <slot />
  </div>

  <slot name="after" />
</Base>

<script>
  const svg = (paths: string) =>
    `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;
  const copyIcon = svg('<rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>');
  const doneIcon = svg('<path d="M20 6 9 17l-5-5"/>');

  if (navigator.clipboard) {
    for (const pre of document.querySelectorAll<HTMLPreElement>(".prose pre")) {
      const wrap = document.createElement("div");
      wrap.className = "code-block";
      pre.replaceWith(wrap);
      wrap.append(pre);

      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "copy";
      const reset = () => {
        btn.innerHTML = copyIcon;
        btn.setAttribute("aria-label", "Copy code");
        btn.title = "Copy";
        delete btn.dataset.state;
      };
      reset();
      let timer = 0;
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText((pre.innerText || "").trimEnd());
          btn.innerHTML = doneIcon;
          btn.setAttribute("aria-label", "Copied");
          btn.title = "Copied";
          btn.dataset.state = "copied";
        } catch {
          btn.setAttribute("aria-label", "Copy failed - select the code and copy it");
          btn.title = "Copy failed";
        }
        window.clearTimeout(timer);
        timer = window.setTimeout(reset, 2000);
      });
      wrap.append(btn);
    }
  }
</script>

<style>
.back {
  display: inline-block;
  font-size: 0.9rem;
  color: var(--muted);
  text-decoration: none;
  margin-bottom: 2.5rem;
}

.back:hover {
  color: var(--fg);
}

.post-header h1 {
  margin-top: 0;
  font-size: clamp(1.85rem, 5vw, 2.75rem);
}

.post-meta {
  color: var(--muted);
  font-size: 0.9rem;
  margin-top: 0.9rem;
}

.post-meta:empty {
  display: none;
}

.post-cover {
  display: block;
  width: auto;
  max-width: 100%;
  max-height: min(30rem, 65vh);
  margin: 2.5rem auto;
  border-radius: var(--radius);
  border: 1px solid var(--hairline);
}
</style>
