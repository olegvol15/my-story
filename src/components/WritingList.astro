---
import { formatDate, getPublishedPosts, toISODate } from "../lib/posts";
import Card from "./Card.astro";
import CardSection from "./CardSection.astro";

interface Props {
  revealDelay?: string;
}

const { revealDelay } = Astro.props;
const posts = await getPublishedPosts();
---

{posts.length > 0 && (
  <CardSection id="writing" heading="Writing" revealDelay={revealDelay}>
    {posts.map(({ id, data }) => (
      <Card href={`/writing/${id}`} title={data.title} cover={data.cover} coverAlt={data.coverAlt}>
        <time datetime={toISODate(data.date)}>{formatDate(data.date)}</time>
      </Card>
    ))}
  </CardSection>
)}
