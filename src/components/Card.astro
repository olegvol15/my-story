---
import { Image } from "astro:assets";

interface Props {
  href: string;
  title: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  logo?: ImageMetadata;
}

const { href, title, cover, coverAlt = "", logo } = Astro.props;
---

<article class="card">
  <div class="card-media">
    {cover ? (
      <Image src={cover} alt={coverAlt} widths={[400, 800]} sizes="(max-width: 640px) 100vw, 22rem" />
    ) : logo ? (
      <span class="card-logo">
        <Image src={logo} alt="" width={96} height={96} />
      </span>
    ) : (
      <span class="card-fallback" aria-hidden="true">{title}</span>
    )}
  </div>
  <h3><a href={href}>{title}</a></h3>
  <div class="card-meta"><slot /></div>
</article>

<style>
.card {
  position: relative;
}

.card-media {
  aspect-ratio: 16 / 9;
  overflow: hidden;
  border-radius: var(--radius);
  border: 1px solid var(--hairline);
  background: var(--surface);
}

.card-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 25%;
  transition:
    transform 0.4s ease,
    opacity 0.3s ease;
  opacity: 0.85;
}

.card:hover .card-media img {
  transform: scale(1.03);
  opacity: 1;
}

.card-logo {
  display: grid;
  place-items: center;
  height: 100%;
}

.card-media .card-logo img {
  width: clamp(4rem, 28%, 6rem);
  height: auto;
  object-fit: contain;
  opacity: 0.9;
}

.card:hover .card-media .card-logo img {
  transform: scale(1.06);
  opacity: 1;
}

.card-fallback {
  display: grid;
  place-items: center;
  height: 100%;
  padding: 1rem;
  text-align: center;
  font-family: var(--font-display), Georgia, serif;
  font-size: clamp(1.5rem, 4vw, 2rem);
  color: var(--muted);
  transition: color 0.3s ease;
}

.card:hover .card-fallback {
  color: var(--fg);
}

.card h3 {
  font-size: 1rem;
  font-weight: 600;
  line-height: 1.4;
  color: var(--fg);
  letter-spacing: -0.01em;
  margin: 0.9rem 0 0.3rem;
}

.card h3 a {
  text-decoration: none;
}

.card h3 a::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: var(--radius);
}

.card-meta {
  font-size: 0.85rem;
  color: var(--muted);
}
</style>
