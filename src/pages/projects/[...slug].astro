---
import { render } from "astro:content";
import type { GetStaticPaths } from "astro";
import { profile } from "../../data/content";
import { formatDate, toISODate } from "../../lib/posts";
import { getPublishedProjects, shippedLog, statusLabel } from "../../lib/projects";
import Article from "../../layouts/Article.astro";

export const getStaticPaths = (async () => {
  const projects = await getPublishedProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, status, started, cover, coverAlt, stack, links, planned } = project.data;
const shipped = shippedLog(project);

const monthYear = (date: Date) =>
  date.toLocaleDateString("en-US", { year: "numeric", month: "long" });
---

<Article
  title={`${title} - ${profile.name}`}
  ogTitle={title}
  description={description}
  heading={title}
  cover={cover}
  coverAlt={coverAlt}
  backHref="/#projects"
>
  <Fragment slot="meta">
    <p class="facts">
      <span class="status" data-status={status}>{statusLabel[status]}</span>
      <span>Started <time datetime={toISODate(started)}>{monthYear(started)}</time></span>
    </p>
    {stack.length > 0 && <p class="stack">{stack.join(" · ")}</p>}
    {links.length > 0 && (
      <ul class="project-links">
        {links.map((link) => (
          <li><a href={link.href} rel="noopener" target="_blank">{link.label} ↗</a></li>
        ))}
      </ul>
    )}
  </Fragment>

  <Content />

  {(planned.length > 0 || shipped.length > 0) && (
    <section slot="after" class="changelog" aria-labelledby="changelog-heading" data-reveal style="--reveal-delay: 320ms">
      <h2 id="changelog-heading">Changelog</h2>

      {planned.length > 0 && (
        <>
          <h3>Up next</h3>
          <ul class="log log-planned">
            {planned.map((item) => <li><p>{item}</p></li>)}
          </ul>
        </>
      )}

      {shipped.length > 0 && (
        <>
          <h3>Shipped</h3>
          <ol class="log">
            {shipped.map((entry) => (
              <li>
                <time datetime={toISODate(entry.date)}>{formatDate(entry.date)}</time>
                <p>{entry.text}</p>
              </li>
            ))}
          </ol>
        </>
      )}
    </section>
  )}
</Article>

<style>
.facts,
.stack {
  margin: 0;
}

.facts {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.4rem 1rem;
}

.status {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  color: var(--fg);
  font-weight: 500;
}

.status::before {
  content: "";
  width: 7px;
  height: 7px;
  border-radius: 999px;
  background: var(--muted);
}

.status[data-status="live"]::before {
  background: #4ade80;
  box-shadow: 0 0 0 3px rgba(74, 222, 128, 0.15);
}

.status[data-status="building"]::before {
  background: var(--body);
}

.stack {
  margin-top: 0.35rem;
}

.project-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem 1.25rem;
  list-style: none;
  margin: 0.6rem 0 0;
  padding: 0;
}

.project-links a {
  color: var(--body);
  text-decoration: none;
}

.project-links a:hover {
  color: var(--fg);
}

.changelog {
  margin-top: clamp(3.5rem, 9vh, 5rem);
  padding-top: 2.5rem;
  border-top: 1px solid var(--hairline);
}

.changelog h2 {
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--fg);
  letter-spacing: -0.01em;
  margin: 0;
}

.changelog h3 {
  font-size: 0.8rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--muted);
  margin: 2rem 0 1rem;
}

/* A timeline: a hairline rail with a dot per entry. */
.log {
  list-style: none;
  margin: 0;
  padding: 0;
  border-left: 1px solid var(--hairline);
}

.log li {
  position: relative;
  padding: 0 0 1.5rem 1.4rem;
}

.log li:last-child {
  padding-bottom: 0;
}

.log li::before {
  content: "";
  position: absolute;
  left: -4px;
  top: 0.55em;
  width: 7px;
  height: 7px;
  border-radius: 999px;
  background: var(--body);
}

.log-planned li::before {
  background: var(--bg);
  border: 1px solid var(--muted);
}

.log time {
  display: block;
  font-size: 0.8rem;
  color: var(--muted);
}

.log p {
  margin: 0;
  color: var(--body);
}

.log-planned p {
  color: var(--muted);
}
</style>
