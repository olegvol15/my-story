---
import { Font } from "astro:assets";
import { getCollection } from "astro:content";
import "../styles/global.css";
import { profile } from "../data/content";
import WritingCard from "../components/WritingCard.astro";
import SocialIcon from "../components/SocialIcon.astro";
import Particles from "../components/Particles.astro";

const title = `${profile.name} - a 20 year old software engineer from Ukraine building stuff and writing about it`;

const posts = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const escape = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const emphasise = (s: string) =>
  escape(s).replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={profile.intro} />
    <meta name="theme-color" content="#08090c" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={profile.intro} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />

    <Font cssVariable="--font-sans" preload />
  </head>
  <body>
    <Particles />
    <main class="wrap">
      <img
        class="avatar"
        src="/my-photo.jpg"
        alt={`${profile.name}`}
        width="640"
        height="640"
        fetchpriority="high"
      />

      <h1>{profile.firstName}{" "}<span class="mark">{profile.lastName}</span></h1>

      <p class="tagline">{profile.tagline}</p>

      <ul class="links">
        {profile.links.map((link) => (
          <li>
            <a
              class="social"
              href={link.href}
              aria-label={link.label}
              rel="me noopener"
              target="_blank"
            >
              <SocialIcon name={link.icon} />
            </a>
          </li>
        ))}
        <li>
          <a id="copy-email" href={`mailto:${profile.email}`} data-email={profile.email}>
            Copy email
          </a>
        </li>
        <li aria-live="polite" class="sr-status" id="copy-status"></li>
      </ul>

      <ul class="milestones">
        {profile.milestones.map((item) => (
          <li><span set:html={emphasise(item)} /></li>
        ))}
      </ul>

      {posts.length > 0 && (
        <section class="writing" aria-labelledby="writing-heading">
          <h2 id="writing-heading">Writing</h2>
          <div class="cards">
            {posts.map((post) => <WritingCard post={post} />)}
          </div>
        </section>
      )}

      <footer class="site-footer">
        <p>{profile.location}</p>
      </footer>
    </main>

    <script>
      const el = document.getElementById("copy-email");
      const status = document.getElementById("copy-status");
      const email = el?.dataset.email;

      if (el && status && email && navigator.clipboard) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.textContent = "Copy email";
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(email);
            status.textContent = "Email copied";
            btn.textContent = "Copied";
            setTimeout(() => {
              btn.textContent = "Copy email";
              status.textContent = "";
            }, 2000);
          } catch {
            status.textContent = "Press Ctrl+C to copy: " + email;
          }
        });
        el.replaceWith(btn);
      }
    </script>
  </body>
</html>
